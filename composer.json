{
  "name": "novadigital/novapost-api-sdk",
  "description": "PHP SDK for Nova Post API",
  "type": "library",
  "require": {
    "php": ">=8.0",
    "guzzlehttp/guzzle": "^7.0",
    "psr/log": "^3.0",
    "psr/container": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "NovaDigital\\NovaPost\\": "src/"
    }
  },
  "require-dev": {
    "vlucas/phpdotenv": "^5.6",
    "phpunit/phpunit": "^12.3",
    "squizlabs/php_codesniffer": "^3.13"
  }
}
